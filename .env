# Airflow metadata Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pass

CLICKHOUSE_USER_LIMITED=limited_user
CLICKHOUSE_PASSWORD_LIMITED=limited_password

CLICKHOUSE_USER_FULL=full_user
CLICKHOUSE_PASSWORD_FULL=full_password

# Airflow admin user
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
